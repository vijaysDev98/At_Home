	<string>Allow access to your photo library to select a profile photo.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Inter_18pt-Bold.ttf</string>
		<string>Inter_18pt-Medium.ttf</string>
		<string>Inter_18pt-SemiBold.ttf</string>
		<string>Inter_18pt-Regular.ttf</string>
	</array>
